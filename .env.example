# =============================================================================
# Quorum — environment template
#
#   cp .env.example .env.local     and fill in the values below.
#
# .env.local is gitignored. Never commit real keys.
# Step-by-step instructions for obtaining each value:
#   Supabase -> docs/SETUP-SUPABASE.md
#   Vercel   -> docs/SETUP-VERCEL.md
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — CLIENT SIDE (these are compiled into the browser bundle)
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Data API  (URL)
#                    -> Project Settings -> API Keys  (publishable key)
#
# The publishable key is public by design. It is only safe because row-level
# security is enabled on every table. Do not disable RLS on anything.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Supabase — SERVER ONLY. NEVER prefix these with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API Keys -> secret key ("service_role")
#
# This key BYPASSES row-level security completely. In this codebase it may be
# read from exactly one file: lib/db/scoped-agent.ts. Anywhere else is a bug.

SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
# The key supplied with the assignment is short-lived. If it expires mid-build,
# set AGENT_ENABLED=false below to degrade to a plain chat rather than erroring.
# Model selection lives in config/models.ts, not here.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Optional — features degrade gracefully when these are absent
# -----------------------------------------------------------------------------
# Web search provider for the search/research tools.
SEARCH_API_KEY=

# Embedding provider for semantic memory ranking. Anthropic has no embeddings
# API, so this needs a separate provider. Provider choice is OPEN — see
# research track R3. Without it, retrieval falls back to lexical + recency.
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# Google connectors — READ-ONLY Gmail and Calendar.  docs/EMAIL-SETUP.md
# -----------------------------------------------------------------------------
# A SECOND authorisation, separate from "sign in with Google": Supabase does not
# hand back a refresh token carrying extra scopes, and reading someone's mail
# should be a grant they make knowingly rather than one that arrives attached to
# signing in.
#
# All four must be present or the connectors are simply not registered — the
# model is never offered a tool that cannot work.
#
# NEVER give the client secret a NEXT_PUBLIC_ prefix. pnpm check:boundaries
# fails the build if you do.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback

# 32 random bytes, base64. Encrypts refresh tokens at rest, so a database
# backup alone yields no mailboxes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# There is deliberately no plaintext fallback: without this the connectors are
# unavailable. Changing it invalidates every stored token and users reconnect.
CONNECTOR_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Kill switches — flip without a code change when something is on fire
# -----------------------------------------------------------------------------
# Any value other than "false" means enabled.

AGENT_ENABLED=true
MEMORY_WRITE_ENABLED=true
TOOLS_ENABLED=true


# -----------------------------------------------------------------------------
# Development sign-in — NEVER set this in production
# -----------------------------------------------------------------------------
# Opens /auth/dev, which signs you in as one of the seeded accounts without
# Google. Demonstrating authorisation needs 3+ identities at once, and doing
# that through real OAuth means three browser profiles.
#
# The route is closed unless BOTH NODE_ENV !== production AND this is the exact
# string "true". Opt-in by design: forgetting to set something can never be
# what opens it.
#
#   pnpm seed:dev     creates the accounts and a demo world
#
ALLOW_DEV_LOGIN=true


# -----------------------------------------------------------------------------
# Admin mode — NEVER set this in production
# -----------------------------------------------------------------------------
# Opens /admin, where you can grant yourself any clearance and join any group,
# so the two authorisation axes can be demonstrated from ONE account instead of
# three. It is not a read bypass: it changes what you hold, and every read
# afterwards runs the same policies as anyone else's.
#
# THREE independent gates, and the important one is not here. As well as
# NODE_ENV != production and this flag, the database refuses unless
# `private.admin_mode_secret` contains a row matching ADMIN_MODE_SECRET below.
# Migration 0016 creates that table EMPTY, so pushing it to production leaves
# admin mode dead on arrival no matter what any environment variable says.
#
# To arm it on a development project, run once against that database:
#
#   insert into private.admin_mode_secret (secret) values ('<the value below>');
#
ALLOW_ADMIN_MODE=true
ADMIN_MODE_SECRET=
